# Copy to .env at the repository root and fill in real values.
# .env is excluded from version control. Never commit a filled copy.

# Project REST endpoint, without a trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. Bypasses row level security, so the pipeline needs it to
# read tables that are otherwise scoped to a single tenant.
# Rotate this key if it is ever committed or pasted into a channel.
SUPABASE_SERVICE_ROLE_KEY=

# The publishable anon key is NOT used. It maps to the anon role, which row
# level security restricts to rooms and buildings.