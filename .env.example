# Copy the settings you need into .env and fill in real values there.
# Never put real passwords or keys in this example. .env is excluded from Git.

# Stage 1: SOURCE Supabase project containing the operational Spartment tables.
# Use the source project's API URL and service-role key, not the warehouse's.
SUPABASE_URL=https://YOUR_SOURCE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stage 3: DESTINATION Supabase project containing your analytical warehouse.
# In that project's dashboard, open Connect > Session pooler > View parameters.
# Copy its host, port, database and username exactly; do not use transaction mode.
# The database name is commonly postgres even when the PROJECT is named
# spartment-warehouse. Use the actual database name shown by Connect.
# Use the destination project's database password, not an API key or account password.
# Keep the outer double quotes; the inner single quotes allow spaces in the password.
SPARTMENT_LOAD_OWNER_DSN="host=YOUR_SESSION_POOLER_HOST port=5432 dbname=postgres user=postgres.YOUR_WAREHOUSE_PROJECT_REF password='YOUR_WAREHOUSE_DATABASE_PASSWORD' sslmode=require"

# Run `spartment-load provision-existing --role spartment_activity_loader` once
# after `inspect --owner` passes. It creates a new role without resetting existing roles
# and saves the correct session-pooler username and generated password in .env.
SPARTMENT_LOAD_DSN=

# Optional CLIENT tools for pg_dump/pg_restore when they are not on PATH.
# This does not require running a local PostgreSQL server.
# SPARTMENT_PG_BIN=C:/Program Files/PostgreSQL/18/bin

# Optional hosted disk-headroom evidence from the destination dashboard.
# Missing/stale evidence holds publication for review; it never pretends your
# laptop's free disk is the Supabase server's free disk. See docs/load.md.
# SPARTMENT_LOAD_CAPACITY_EVIDENCE=loaded/capacity.json
